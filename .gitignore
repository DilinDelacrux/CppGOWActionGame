# ====================================================================
# 1. 虚幻引擎通用过滤规则 (Unreal Engine General)
# ====================================================================
# 过滤虚幻引擎自动生成的项目文件
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vs/

# 过滤编译出来的临时对象与库文件
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa

# 过滤引擎资产预编译与地图数据
SourceArt/**/*.png
SourceArt/**/*.tga
*_BuiltData.uasset

# 过滤项目核心二进制与临时目录
Binaries/*
Build/*
Pak/*
Saved/*
Intermediate/*
DerivedDataCache/*

# 允许 Build 目录下的特定配置文件进入版本控制
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# ====================================================================
# 2. 核心修复：防止 Plugins 里的 Binaries/Intermediate 被打包
# ====================================================================
# 递归过滤所有插件目录下的 Binaries 和 Intermediate 文件夹（包含 PuerTS 插件）
Plugins/**/Binaries/*
Plugins/**/Intermediate/*

# 如果你在 Plugins 放入了源码，防止产生遗留的 C++ 对象文件
Plugins/**/*.obj
Plugins/**/*.pdb
Plugins/**/*.ilk
Plugins/**/*.exp
Plugins/**/*.lib

# ====================================================================
# 3. PuerTS / JavaScript 专属过滤规则
# ====================================================================
# 过滤 Node 环境自动生成的本地依赖库（必须由本地 npm install 或 PuerTS 自动释放）
Content/JavaScript/node_modules/
Plugins/Puerts/Content/JavaScript/node_modules/

# 过滤 TypeScript 编译器生成的本地缓存文件
*.tsbuildinfo

# 允许提交你在 Content/JavaScript/ 下编写的业务代码 (.ts / .js)
!Content/JavaScript/**/puerts/*.js
!Content/JavaScript/puerts/

# ====================================================================
# 4. 外部 Actor 与特定地图大世界划分资产 (保留原有配置)
# ====================================================================
Content/__ExternalObjects__/ThirdPerson/Maps/ThirdPersonMap/
Content/__ExternalObjects__/Map/FeatureDevMap/
Content/__ExternalObjects__/Map/FeatureDeathMap/
Content/__ExternalActors__/ThirdPerson/Maps/ThirdPersonMap/
Content/__ExternalActors__/Map/FeatureDevMap/
Content/__ExternalActors__/Map/FeatureDeathMap/