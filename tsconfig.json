{
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "jsx": "react",
        "sourceMap": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "typeRoots": [
            "Typing",
            "Content/JavaScript/node_modules/@types",
            "./node_modules/@types"
        ],
        "outDir": "Content/JavaScript"
    },
    "include": [
        "TypeScript/**/*"
    ]
}
